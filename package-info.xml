<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "https://www.elkarte.net/site/package-info">
<package-info xmlns="https://www.elkarte.net/site/package-info" xmlns:elk="https://www.elkarte.net/">
	<id>Levertine:Gallery</id>
	<name>Levertine Gallery</name>
	<version>2.0.0</version>
	<type>addon</type>

	<install for="2.0.0 Beta 1 - 2.0.99">
		<!-- readme files -->
		<readme lang="english" parsebbc="true" type="file">readme/readme.english.txt</readme>

		<!-- Dependencies -->
		<require-dir name="Languages/Levertine" destination="LANGUAGEDIR">Language files</require-dir>
		<require-dir name="Levertine" destination="ADDONSDIR">Source files</require-dir>
		<require-dir name="themes" destination="BOARDDIR">Templates/CSS/JS</require-dir>

        <require-file name="other/MGalleryItem.php" destination="BOARDDIR">Compatability</require-file>
        <require-file name="other/ScheduledTasks/Tasks/LevgalMaintenance.php" destination="ELKARTEDIR/ScheduledTasks/Tasks/">Scheduled Task</require-file>

        <require-file name="other/Event/Lgcomment.php" destination="ELKARTEDIR/Mentions/MentionType/Event/">Notifications</require-file>
        <require-file name="other/Event/Lglike.php" destination="ELKARTEDIR/Mentions/MentionType/Event/">"</require-file>
        <require-file name="other/Event/Lgnew.php" destination="ELKARTEDIR/Mentions/MentionType/Event/">"</require-file>
        <require-file name="other/Notification/Lgcomment.php" destination="ELKARTEDIR/Mentions/MentionType/Notification/">"</require-file>
        <require-file name="other/Notification/Lglike.php" destination="ELKARTEDIR/Mentions/MentionType/Notification/">"</require-file>
        <require-file name="other/Notification/Lgnew.php" destination="ELKARTEDIR/Mentions/MentionType/Notification/">"</require-file>

        <!-- And the most important bit -->
		<require-dir name="lgal_items" destination="BOARDDIR">Storage for files</require-dir>

		<!-- Database -->
		<database>install.php</database>

		<!-- And on to the admin panel. -->
		<redirect url="?action=admin;area=lgaldash" />
	</install>

	<uninstall  for="2.0.0 Beta 1 - 2.0.99">
        <!-- Hooks and Tasks -->
        <code>uninstall-required.php</code>

        <!-- Dependencies -->
		<remove-dir name="ADDONSDIR/Levertine">Removing source files</remove-dir>
		<remove-dir name="THEMEDIR/Levertine">Removing template/CSS/JS</remove-dir>
		<remove-dir name="LANGUAGEDIR/Levertine">Removing language files</remove-dir>

		<!-- Support -->
		<remove-file name="BOARDDIR/MGalleryItem.php">Removing Compatibility File</remove-file>
        <remove-file name="ELKARTEDIR/ScheduledTasks/Tasks/LevgalMaintenance.php">Removing Scheduled Task</remove-file>
        <remove-file name="ELKARTEDIR/Mentions/MentionType/Event/Lgcomment.php">Removing Notifications</remove-file>
        <remove-file name="ELKARTEDIR/Mentions/MentionType/Event/Lglike.php">Removing Notifications</remove-file>
        <remove-file name="ELKARTEDIR/Mentions/MentionType/Event/Lgnew.php">Removing Notifications</remove-file>
        <remove-file name="ELKARTEDIR/Mentions/MentionType/Notification/Lgcomment.php">Removing Notifications</remove-file>
        <remove-file name="ELKARTEDIR/Mentions/MentionType/Notification/Lglike.php">Removing Notifications</remove-file>
        <remove-file name="ELKARTEDIR/Mentions/MentionType/Notification/Lgnew.php">Removing Notifications</remove-file>

        <!-- Database -->
		<database>uninstall-optional.php</database>
	</uninstall>

</package-info>
